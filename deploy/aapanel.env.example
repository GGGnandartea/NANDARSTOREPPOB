# Merge these settings into the existing VPS .env. Do not replace the whole file.
# Keep the existing APP_KEY, database credentials and provider credentials.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://v2.premiumkita.com

SESSION_DRIVER=file
SESSION_COOKIE=nandarstore_v2_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Configure only actual proxy IPs/CIDRs if forwarded HTTPS/IP detection is needed.
# TRUSTED_PROXIES=
